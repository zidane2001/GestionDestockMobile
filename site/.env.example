# Copier en .env pour un essai local (fichier ignoré par Git).

# Postgres : URL Neon (ou toute base Postgres). Sans elle, le site utilise
# PGlite local, uniquement pour le développement.
DATABASE_URL=

# Mot de passe du back-office (8 caractères minimum).
ADMIN_PASSWORD=

# Secret de signature des cookies de session (16 caractères minimum).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Lien de téléchargement par défaut de l'APK.
LIEN_APK=https://github.com/zidane2001/GestionDestockMobile/releases

# Port d'écoute (Render le fournit automatiquement).
PORT=3000
